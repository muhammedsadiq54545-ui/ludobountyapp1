<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090D16">

    <!-- Top Navigation & Status Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="#0D1322"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#F59E0B" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvGameTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LUDO BOUNTY"
                android:textColor="#F59E0B"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvGameSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Classic Tournament Mode"
                android:textColor="#94A3B8"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvCoins"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@android:drawable/dialog_holo_dark_frame"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="1,250 🪙"
            android:textColor="#FBBF24"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Top Player Row: GREEN (top-left) and RED (top-right) aligned directly with Ludo board edges -->
    <LinearLayout
        android:id="@+id/topPlayersRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="@id/ludoBoardView"
        app:layout_constraintEnd_toEndOf="@id/ludoBoardView">

        <!-- 1. Top Left: Player GREEN Info (Avatar, Role, Home, Progress) -->
        <LinearLayout
            android:id="@+id/playerGreenInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivPlayerGreenAvatar"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="Green Player Avatar"
                    android:src="@android:drawable/ic_menu_myplaces" />

                <TextView
                    android:id="@+id/tvPlayerGreenRole"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="#059669"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="1dp"
                    android:text="Human"
                    android:textColor="#FFFFFF"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPlayerGreenTokensHome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="0/4"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/pbPlayerGreen"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="72dp"
                android:layout_height="4dp"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progress="0" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- 2. Top Right: Player RED Info (Avatar, Role, Home, Progress) -->
        <LinearLayout
            android:id="@+id/playerRedInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:gravity="end"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvPlayerRedTokensHome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:text="0/4"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPlayerRedRole"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="#DC2626"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="1dp"
                    android:text="AI"
                    android:textColor="#FFFFFF"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/ivPlayerRedAvatar"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="Red Player Avatar"
                    android:src="@android:drawable/ic_menu_myplaces" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/pbPlayerRed"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="72dp"
                android:layout_height="4dp"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progress="0" />
        </LinearLayout>
    </LinearLayout>

    <!-- Centered 15x15 Ludo Board (Square proportions, margins leave clearance for side ROLL buttons) -->
    <com.ludobounty.game.ui.LudoBoardView
        android:id="@+id/ludoBoardView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="64dp"
        android:layout_marginEnd="64dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/topPlayersRow"
        app:layout_constraintBottom_toTopOf="@id/bottomRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintVertical_bias="0.5" />

    <!-- 1. Green ROLL Button: Upper-left outside edge of the board ("Green Roll") -->
    <FrameLayout
        android:id="@+id/btnRollGreen"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="12dp"
        android:background="#FFFFFF"
        app:layout_constraintEnd_toStartOf="@id/ludoBoardView"
        app:layout_constraintTop_toTopOf="@id/ludoBoardView">

        <TextView
            android:id="@+id/tvDiceGreen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="ROLL"
            android:textColor="#1E293B"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:background="#F59E0B"
            android:paddingHorizontal="4dp"
            android:text="TAP"
            android:textColor="#451A03"
            android:textSize="8sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- 2. Red ROLL Button: Upper-right outside edge of the board ("Red Roll") -->
    <FrameLayout
        android:id="@+id/btnRollRed"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="12dp"
        android:background="#FFFFFF"
        app:layout_constraintStart_toEndOf="@id/ludoBoardView"
        app:layout_constraintTop_toTopOf="@id/ludoBoardView">

        <TextView
            android:id="@+id/tvDiceRed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="ROLL"
            android:textColor="#1E293B"
            android:textSize="12sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- 3. Yellow ROLL Button: Lower-left outside edge of the board ("Yellow Roll") -->
    <FrameLayout
        android:id="@+id/btnRollYellow"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="12dp"
        android:background="#FFFFFF"
        app:layout_constraintEnd_toStartOf="@id/ludoBoardView"
        app:layout_constraintBottom_toBottomOf="@id/ludoBoardView">

        <TextView
            android:id="@+id/tvDiceYellow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="ROLL"
            android:textColor="#1E293B"
            android:textSize="12sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- 4. Blue ROLL Button: Lower-right outside edge of the board ("Blue Roll") -->
    <FrameLayout
        android:id="@+id/btnRollBlue"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="12dp"
        android:background="#FFFFFF"
        app:layout_constraintStart_toEndOf="@id/ludoBoardView"
        app:layout_constraintBottom_toBottomOf="@id/ludoBoardView">

        <TextView
            android:id="@+id/tvDiceBlue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="ROLL"
            android:textColor="#1E293B"
            android:textSize="12sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- Bottom Row: Player YELLOW (bottom-left) and BLUE (bottom-right) aligned directly with Ludo board edges -->
    <LinearLayout
        android:id="@+id/bottomRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@id/ludoBoardView"
        app:layout_constraintEnd_toEndOf="@id/ludoBoardView">

        <!-- 3. Bottom Left: Player YELLOW Info (Avatar, Role, Home, Progress) -->
        <LinearLayout
            android:id="@+id/playerYellowInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivPlayerYellowAvatar"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="Yellow Player Avatar"
                    android:src="@android:drawable/ic_menu_myplaces" />

                <TextView
                    android:id="@+id/tvPlayerYellowRole"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="#D97706"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="1dp"
                    android:text="Human"
                    android:textColor="#FFFFFF"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPlayerYellowTokensHome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="0/4"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/pbPlayerYellow"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="72dp"
                android:layout_height="4dp"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progress="0" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- 4. Bottom Right: Player BLUE Info (Avatar, Role, Home, Progress) -->
        <LinearLayout
            android:id="@+id/playerBlueInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:gravity="end"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvPlayerBlueTokensHome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:text="0/4"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPlayerBlueRole"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="#2563EB"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="1dp"
                    android:text="AI"
                    android:textColor="#FFFFFF"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/ivPlayerBlueAvatar"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="Blue Player Avatar"
                    android:src="@android:drawable/ic_menu_myplaces" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/pbPlayerBlue"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="72dp"
                android:layout_height="4dp"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progress="0" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
